<Application x:Class="Translator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Colors and brushes ("InkBrush", "SageColor", …) are written at runtime by UI/ThemeManager. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Styles/Base.xaml" />
                <ResourceDictionary Source="UI/Styles/Buttons.xaml" />
                <ResourceDictionary Source="UI/Styles/Inputs.xaml" />
                <ResourceDictionary Source="UI/Styles/Menus.xaml" />
                <ResourceDictionary Source="UI/Styles/Surfaces.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
