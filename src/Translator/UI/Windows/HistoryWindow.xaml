<w:AuxWindow x:Class="Translator.UI.Windows.HistoryWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Translator.UI"
             xmlns:c="clr-namespace:Translator.UI.Controls"
             xmlns:w="clr-namespace:Translator.UI.Windows"
             Title="{ui:Loc history}">
    <StackPanel Width="440">
        <StackPanel Margin="18">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Foreground="{DynamicResource RoseInkBrush}"
                        Content="{ui:Loc clear}" Click="OnClearClick"
                        Visibility="{Binding History.Count, Converter={StaticResource VisibleWhen}}" />
                <c:LogoMark DockPanel.Dock="Left" Size="30" VerticalAlignment="Center" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleText}" FontSize="16" Text="{ui:Loc history}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource SubtitleText}" FontSize="11.5" />
                </StackPanel>
            </DockPanel>

            <StackPanel Margin="0,12,0,0" MinHeight="180" VerticalAlignment="Center"
                        Visibility="{Binding History.Count, Converter={StaticResource CollapsedWhen}}">
                <TextBlock Margin="0,50,0,0" HorizontalAlignment="Center" Style="{StaticResource IconText}" FontSize="28"
                           Foreground="{DynamicResource InkGhostBrush}" Text="{x:Static ui:Icons.History}" />
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource InkCaptionBrush}" Text="{ui:Loc history.empty}" />
            </StackPanel>

            <ScrollViewer x:Name="Scroller" Margin="0,12,0,0" MaxHeight="440" Focusable="False"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnScrollerPreviewMouseWheel"
                          Visibility="{Binding History.Count, Converter={StaticResource VisibleWhen}}">
                <ItemsControl x:Name="Entries" ItemsSource="{Binding History}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Style="{StaticResource Card}" Padding="12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="10.5" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SageBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="PairText" />
                                                    <Binding Path="EngineText" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource InkFaintBrush}" Text="{Binding DateText}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineStackingStrategy="BlockLineHeight" LineHeight="17" MaxHeight="34"
                                               Foreground="{DynamicResource InkStrongBrush}" Text="{Binding Input}" />
                                    <Border Margin="0,8" Style="{StaticResource Divider}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                                Style="{StaticResource IconCircleButton24}" Content="{x:Static ui:Icons.Copy}"
                                                Click="OnCopyClick" ToolTip="{ui:Loc copy.translation}"
                                                AutomationProperties.Name="{ui:Loc copy.translation}" />
                                        <TextBox Style="{StaticResource ReadOnlyTextBox}" FontSize="13" MaxLines="4"
                                                 VerticalScrollBarVisibility="Disabled" Text="{Binding Output, Mode=OneWay}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </StackPanel>
</w:AuxWindow>
