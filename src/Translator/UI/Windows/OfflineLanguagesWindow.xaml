<w:AuxWindow x:Class="Translator.UI.Windows.OfflineLanguagesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Translator.UI"
             xmlns:c="clr-namespace:Translator.UI.Controls"
             xmlns:w="clr-namespace:Translator.UI.Windows"
             Title="{ui:Loc offline.languages, TrimEllipsis=True}">
    <StackPanel Width="440">
        <StackPanel Margin="18">
            <StackPanel Orientation="Horizontal">
                <c:LogoMark Size="30" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource TitleText}" FontSize="16"
                           Text="{ui:Loc offline.languages, TrimEllipsis=True}" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionText}" Foreground="{DynamicResource InkMutedBrush}"
                       Text="{ui:Loc offline.intro}" />

            <Border Margin="0,12,0,0" Style="{StaticResource Card}" CornerRadius="10" Padding="10"
                    Visibility="{Binding OfflineUpdateMessage, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Margin="0,1,8,0" VerticalAlignment="Top" Style="{StaticResource IconText}"
                               Foreground="{DynamicResource SageBrush}" Text="{x:Static ui:Icons.Sync}" />
                    <Button DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Top" Style="{StaticResource LinkButton}"
                            FontSize="11.5" Foreground="{DynamicResource InkSubtleBrush}" Content="{ui:Loc later}" Click="OnLaterClick" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource InkStrongBrush}" Text="{Binding OfflineUpdateMessage}" />
                </DockPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource Card}" Padding="0,4">
                <StackPanel>
                    <DockPanel Margin="12,10">
                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource SageBrush}" />
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource SageBrush}"
                                   Text="{ui:Loc base.language}" />
                        <TextBlock x:Name="EnglishName" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
                    </DockPanel>
                    <ItemsControl x:Name="Rows" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Margin="12,0" Style="{StaticResource Divider}" />
                                    <Grid Margin="12,7" MinHeight="26">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource RoseBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Actions.Dot}" Value="{x:Static w:OfflineDot.Ready}">
                                                            <Setter Property="Fill" Value="{DynamicResource SageBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Actions.Dot}" Value="{x:Static w:OfflineDot.Unavailable}">
                                                            <Setter Property="Fill" Value="{DynamicResource InkGhostBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <!-- The quality note sits under the name so the row actions keep their room. -->
                                        <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                            <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="{DynamicResource InkFaintBrush}"
                                                       Text="{ui:Loc offline.quality.basic}"
                                                       Visibility="{Binding IsBasicQuality, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Not installed: size + Download -->
                                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource InkFaintBrush}"
                                                       Text="{Binding SizeText}" Visibility="{Binding Actions.ShowDownload, Converter={StaticResource VisibleWhen}}" />
                                            <Button Style="{StaticResource AccentRowButton}" Tag="{x:Static ui:Icons.Download}"
                                                    Content="{ui:Loc download}" Click="OnDownloadClick" IsEnabled="{Binding CanStart}"
                                                    Visibility="{Binding Actions.ShowDownload, Converter={StaticResource VisibleWhen}}" />
                                            <!-- Downloading: percent + Cancel -->
                                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource InkMutedBrush}"
                                                       Text="{Binding ProgressText}" Visibility="{Binding Actions.ShowProgress, Converter={StaticResource VisibleWhen}}" />
                                            <Button Style="{StaticResource RowButton}" Tag="{x:Static ui:Icons.Close}"
                                                    Content="{ui:Loc offline.cancel}" Click="OnCancelClick"
                                                    Visibility="{Binding Actions.ShowProgress, Converter={StaticResource VisibleWhen}}" />
                                            <!-- Installed: status chip (or Update) + Remove -->
                                            <Border Style="{StaticResource SuccessChip}"
                                                    Visibility="{Binding Actions.ShowDownloaded, Converter={StaticResource VisibleWhen}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="{x:Static ui:Icons.Check}" />
                                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{ui:Loc downloaded}" />
                                                </StackPanel>
                                            </Border>
                                            <Button Style="{StaticResource SoftAccentRowButton}" Tag="{x:Static ui:Icons.Sync}"
                                                    Content="{ui:Loc update}" Click="OnDownloadClick" IsEnabled="{Binding CanStart}"
                                                    Visibility="{Binding Actions.ShowUpdate, Converter={StaticResource VisibleWhen}}" />
                                            <Button Margin="8,0,0,0" Style="{StaticResource DangerRowButton}" Tag="{x:Static ui:Icons.Delete}"
                                                    Content="{ui:Loc offline.remove}" Click="OnRemoveClick" IsEnabled="{Binding CanStart}"
                                                    Visibility="{Binding Actions.ShowRemove, Converter={StaticResource VisibleWhen}}" />
                                            <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource InkFaintBrush}"
                                                       Text="{ui:Loc unsupported}" Visibility="{Binding Actions.ShowUnsupported, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Margin="27,0,12,8" Style="{StaticResource ThinProgress}" Maximum="100" Value="{Binding Progress}"
                                                 Visibility="{Binding Actions.ShowProgress, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11.5" Visibility="Collapsed" />

            <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionText}" FontSize="11" Foreground="{DynamicResource InkSubtleBrush}"
                       Text="{ui:Loc offline.disk.note}" />

            <Button Margin="0,14,0,0" HorizontalAlignment="Right" Style="{StaticResource PillButton}" IsDefault="True"
                    Content="{ui:Loc close}" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</w:AuxWindow>
