<w:FloatingWindow x:Class="Translator.UI.Windows.BubbleWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="clr-namespace:Translator.UI"
                  xmlns:c="clr-namespace:Translator.UI.Controls"
                  xmlns:w="clr-namespace:Translator.UI.Windows"
                  Title="{ui:Loc app.title}"
                  Width="330">
    <StackPanel Margin="14">
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource RoseInkBrush}"
                   Text="{Binding ErrorMessage}" />
        <StackPanel x:Name="ProgressRow" Orientation="Horizontal">
            <c:Spinner />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                       Foreground="{DynamicResource InkMutedBrush}" Text="{ui:Loc translating}" />
        </StackPanel>
        <!-- About 12 lines of text before it scrolls. -->
        <TextBox x:Name="OutputBox" Style="{StaticResource ReadOnlyTextBox}" MaxHeight="228"
                 VerticalScrollBarVisibility="Auto" Text="{Binding OutputText, Mode=OneWay}" />

        <DockPanel Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="ReplaceButton" DockPanel.Dock="Left" Style="{StaticResource PillButton}" IsDefault="True"
                    Content="{ui:Loc replace}" Click="OnReplaceClick" ToolTip="{ui:Loc replace.help}"
                    IsEnabled="{Binding OutputText, Converter={StaticResource Truthy}}" />
            <Button DockPanel.Dock="Left" Margin="8,0,0,0" Style="{StaticResource IconCircleButton24}"
                    Background="{DynamicResource SkyBrush}" Content="{x:Static ui:Icons.Speaker}" Click="OnSpeakClick"
                    IsEnabled="{Binding OutputText, Converter={StaticResource Truthy}}"
                    ToolTip="{ui:Loc speak.translation}" AutomationProperties.Name="{ui:Loc speak.translation}" />
            <Button x:Name="CopyButton" DockPanel.Dock="Left" Margin="8,0,0,0" Style="{StaticResource IconCircleButton24}"
                    Content="{x:Static ui:Icons.Copy}" Click="OnCopyClick"
                    IsEnabled="{Binding OutputText, Converter={StaticResource Truthy}}"
                    ToolTip="{ui:Loc copy.translation}" AutomationProperties.Name="{ui:Loc copy.translation}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Content="{x:Static ui:Icons.Expand}"
                    Click="OnExpandClick" ToolTip="{ui:Loc expand.panel}" AutomationProperties.Name="{ui:Loc expand.panel}" />
            <TextBlock x:Name="EngineText" DockPanel.Dock="Right" Margin="0,0,6,0" VerticalAlignment="Center"
                       FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource SageBrush}"
                       Text="{Binding EngineLabel}" />
        </DockPanel>
    </StackPanel>
</w:FloatingWindow>
