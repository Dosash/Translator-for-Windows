<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary pill (macOS PillButtonStyle): accent fill, darker when pressed. -->
    <Style x:Key="PillButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource SageBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource PillFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill" CornerRadius="16" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                  Color="{DynamicResource SecondaryGlowColor}" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Overlay" CornerRadius="16" Opacity="0"
                                Background="{DynamicResource HoverOverlayBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource PressedFillBrush}" />
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round icon button (macOS IconCircleButtonStyle). Background picks the tint (sage / sky / rose). -->
    <Style x:Key="IconCircleButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource SageBrush}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource CircleFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Ellipse x:Name="Fill" Fill="{TemplateBinding Background}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270"
                                                  Color="{DynamicResource SecondaryGlowColor}" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Overlay" Opacity="0" Fill="{DynamicResource HoverOverlayBrush}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Fill" Value="{DynamicResource PressedFillBrush}" />
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconCircleButton24" TargetType="ButtonBase" BasedOn="{StaticResource IconCircleButton}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="10.5" />
    </Style>

    <Style x:Key="IconCircleButton26" TargetType="ButtonBase" BasedOn="{StaticResource IconCircleButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Text link ("Offline languages…", "Later", "Clear"). -->
    <Style x:Key="LinkButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource SageBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource RoundedFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Label" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet round icon (footer history / settings / quit, bubble expand). -->
    <Style x:Key="GhostIconButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource CircleFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource GhostHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource ControlStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selectable card (settings theme / panel size). Content reads IsChecked for its checkmark. -->
    <Style x:Key="OptionCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource RoundedFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Card" CornerRadius="10" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource InkGhostBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedControlFillBrush}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SageBrush}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selectable capsule (first-run theme choice). -->
    <Style x:Key="OptionCapsule" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource PillFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Capsule" CornerRadius="17" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}">
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Fill="{DynamicResource SageBrush}" Visibility="Collapsed" />
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{DynamicResource IconFontFamily}" FontSize="8"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Capsule" Property="BorderBrush" Value="{DynamicResource InkGhostBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Capsule" Property="Background" Value="{DynamicResource SelectedControlFillBrush}" />
                            <Setter TargetName="Capsule" Property="BorderBrush" Value="{DynamicResource SageBrush}" />
                            <Setter TargetName="Capsule" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource SageBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
