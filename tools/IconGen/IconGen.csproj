<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone icon generator for Translator. Not part of Translator.slnx / the app build:
    run it manually (or after tweaking the design) to regenerate:
      - src/Translator/Assets/AppIcon.ico  (16, 20, 24, 32, 40, 48, 64, 256 px, PNG-compressed frames)
      - docs/images/icon-256.png           (256 px preview for the README)

    Usage: run it with "dotnet run" pointed at this project directory (tools\IconGen).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IconGen</RootNamespace>
    <AssemblyName>IconGen</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Never let this dev tool leak into the app's publish output. -->
    <EnableDefaultItems>true</EnableDefaultItems>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

</Project>
